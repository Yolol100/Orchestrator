{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webactueel.nl/schemas/github-dispatch-request-v1.json",
  "title": "Webactueel GitHub dispatch request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "id_seed_sha256",
    "work_item_id",
    "generation",
    "idempotency_key",
    "registry_fingerprint",
    "transport_mode",
    "workflow_state",
    "runtime_state",
    "approval_policy",
    "return_to",
    "execution_order",
    "dependency_receipts",
    "nodes",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^WF-[A-F0-9]{12}$"
    },
    "id_seed_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registry_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transport_mode": {
      "enum": [
        "connector_managed",
        "github_app",
        "reusable_workflow",
        "handoff_required"
      ]
    },
    "workflow_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "runtime_state": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "blocked",
        "needs_approval",
        "validating",
        "complete",
        "cancelled"
      ]
    },
    "approval_policy": {
      "enum": [
        "autonomous",
        "approval_before_write",
        "approval_before_publish",
        "human_only"
      ]
    },
    "return_to": {
      "const": "webactueel-workflow"
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_set_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_manifest_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependency_receipts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "accepted_by",
          "generation",
          "checkpoint_id",
          "evidence_ids"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          },
          "accepted_by": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "checkpoint_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "owner_skill",
          "project_id",
          "workflow",
          "dependencies",
          "operation",
          "input_fingerprint",
          "remote_trigger",
          "dispatcher",
          "invocation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "owner_skill": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\.github/workflows/[^/]+\\.(yml|yaml)$"
          },
          "request_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_file_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote_trigger": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "operation": {
            "enum": [
              "read",
              "scan",
              "test",
              "write",
              "publish",
              "release"
            ]
          },
          "input_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dispatcher": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "support",
              "required_permissions",
              "default_operation"
            ],
            "properties": {
              "support": {
                "enum": [
                  "request_file",
                  "workflow_dispatch",
                  "handoff_required",
                  "pull_request"
                ]
              },
              "branch_mode": {
                "enum": [
                  "ephemeral_runtime_branch",
                  "append_existing_branch",
                  "ephemeral_pull_request_branch"
                ]
              },
              "base_ref": {
                "type": "string",
                "minLength": 1
              },
              "target_branch": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "required_permissions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "contents": {
                    "enum": [
                      "read",
                      "write"
                    ]
                  },
                  "actions": {
                    "enum": [
                      "read",
                      "write"
                    ]
                  },
                  "pull_requests": {
                    "enum": [
                      "read",
                      "write"
                    ]
                  }
                }
              },
              "default_operation": {
                "enum": [
                  "read",
                  "scan",
                  "test",
                  "write",
                  "publish",
                  "release"
                ]
              },
              "request_id_pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "invocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "request_file",
                  "workflow_dispatch",
                  "pull_request"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch_mode": {
                "enum": [
                  "ephemeral_runtime_branch",
                  "append_existing_branch",
                  "ephemeral_pull_request_branch"
                ]
              },
              "target_branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "payload": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inputs": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_retries",
        "retry_only_transient",
        "fail_closed",
        "timeout_minutes",
        "rollback_required"
      ],
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "retry_only_transient": {
          "const": true
        },
        "fail_closed": {
          "const": true
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "rollback_required": {
          "type": "boolean"
        }
      }
    }
  }
}
