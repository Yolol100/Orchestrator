      "role": "caption-acquisition-runtime",
      "status": "active"
    }
  ],
  "consolidations": [
    {
      "source": "Yolol100/Checklist",
      "target": "Yolol100/Designchecker",
      "status": "migration",
      "source_runtime_status": "legacy-active-until-evidence-parity",
      "remove_after": [
        "formal-evidence parity is tested",
        "orchestrator routing is switched",
        "Website QA accepts correlated replacement evidence"
      ]
    },
    {
      "source": "Yolol100/Elementorconnector",
      "target": "Yolol100/wordpressconnector",
      "status": "migration",
      "source_runtime_status": "maintenance-only-until-live-bridge-parity",
      "remove_after": [
        "state-token and capability-inventory parity is tested",
        "staging read/write/rollback matrix passes",
        "all active site routes use wordpressconnector"
      ]
    },
    {
      "source": "Yolol100/Export-acf-to-csv",
      "target": "Yolol100/ACF-Text-Manager",
      "status": "duplicate-deprecation",
      "source_runtime_status": "no-new-development",
      "remove_after": [
        "unique commits are reconciled",
        "release users are directed to the canonical repository"
      ]
    }
  ],
  "deprecated_repositories": [
    {
      "repository": "Yolol100/elementor-design-kit-generator",
